# ===========================================
# Vauln Address - Local Development
# ===========================================
# 
# For local development only (127.0.0.1)
#
# Setup:
# 1. Backend must be running on port 9111
# 2. Frontend built files in ./frontend/dist
# 3. Copy to /etc/nginx/sites-available/ and symlink
#

server {
    listen 80;
    listen [::]:80;
    
    server_name localhost 127.0.0.1;
    
    root /path/to/vauln-address/frontend/dist;
    index index.html;

    gzip on;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml;

    location /api/ {
        proxy_pass http://127.0.0.1:9111;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
