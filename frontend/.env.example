# ===========================================
# Vauln Address - Frontend Configuration
# ===========================================

# API Base URL - subdomain for API calls
# DEV:  https://api.dev.pwnd.info
# PROD: https://api.pwnd.info
# Leave empty to use same origin (for local development)
VITE_API_URL=

# Solana RPC URL
# DEV:  https://api.devnet.solana.com
# PROD: https://api.mainnet-beta.solana.com
# Or use private RPC providers like Helius, QuickNode, etc.
VITE_SOLANA_RPC=https://api.devnet.solana.com

# Solana Cluster (for Solana Explorer links)
# Options: devnet, mainnet-beta
VITE_SOLANA_CLUSTER=devnet
