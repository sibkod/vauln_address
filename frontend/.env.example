# ===========================================
# Vauln Address - Frontend Configuration
# ===========================================

# Solana RPC URL
# For devnet: https://api.devnet.solana.com
# For mainnet: https://api.mainnet-beta.solana.com
# Or use private RPC providers like Helius, QuickNode, etc.
VITE_SOLANA_RPC=https://api.devnet.solana.com

# Solana Cluster (for Solana Explorer links)
# Options: devnet, mainnet-beta
VITE_SOLANA_CLUSTER=devnet
