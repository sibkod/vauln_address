# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vauln_address
DB_SSLMODE=disable

# Server
SERVER_PORT=9111

# ============ Free Checks Configuration ============
# Number of free checks per IP per day
FREE_CHECK_LIMIT=3

# ============ Solana Payment Configuration ============
# Set to "true" for devnet testing, "false" for mainnet
SOLANA_USE_DEVNET=true

# Your Solana receiving address for payments
# Leave empty to use demo mode
SOLANA_PAYMENT_ADDR=

# Custom RPC URL (optional)
# If not set, defaults to:
#   - https://api.devnet.solana.com (devnet)
#   - https://api.mainnet-beta.solana.com (mainnet)
# You can use private RPC providers like Helius, QuickNode, etc.
# SOLANA_RPC_URL=https://api.devnet.solana.com

# ============ Pricing Configuration ============
# SOL price in USD (fetched from CoinGecko every 5 minutes)
# This is a fallback if CoinGecko API is unavailable
SOLANA_PRICE_USD=150.0

# Price per check in USD
PRICE_PER_CHECK_USD=0.10

# ============ Admin Configuration ============
# Admin API key for protected endpoints (POST /api/admin/wallets)
# Generate a secure key: openssl rand -hex 32
ADMIN_API_KEY=

# ============ Wallet Import Queue ============
# Wallet imports are processed by a single background worker in batched
# transactions. Tune these under heavy concurrent load.
# Max queued import requests before the API returns 503 QUEUE_FULL
WALLET_QUEUE_SIZE=10000
# Max requests written in one database transaction
WALLET_BATCH_SIZE=100
# Max milliseconds to wait for a batch to fill before flushing
WALLET_FLUSH_INTERVAL_MS=200
# Seconds the sync endpoint (POST /api/admin/wallets) waits for the result
# before falling back to a 202 response with a job_id
WALLET_SYNC_WAIT_SECONDS=10

# ============ Telegram Bot (drainer report notifications) ============
# Bot token from @BotFather and the chat ID where reports are forwarded
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ Solana drainer scanner (solana_scan.py) ============
# The scanner posts findings to POST /api/admin/scanner/findings with the
# X-Admin-Key header. Run it with:
#   VAULN_API_URL=http://localhost:9111 ADMIN_API_KEY=<key> \
#     python3 solana_scan.py watch
