# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vauln_address
DB_SSLMODE=disable

# Server
SERVER_PORT=8080

# ============ Free Checks Configuration ============
# Number of free checks per IP per day
FREE_CHECK_LIMIT=3

# ============ Solana Payment Configuration ============
# Set to "true" for devnet testing, "false" for mainnet
SOLANA_USE_DEVNET=true

# Your Solana receiving address for payments
# Leave empty to use demo mode
SOLANA_PAYMENT_ADDR=

# Custom RPC URL (optional)
# If not set, defaults to:
#   - https://api.devnet.solana.com (devnet)
#   - https://api.mainnet-beta.solana.com (mainnet)
# You can use private RPC providers like Helius, QuickNode, etc.
# SOLANA_RPC_URL=https://api.devnet.solana.com

# ============ Pricing Configuration ============
# SOL price in USD (fetched from CoinGecko every 5 minutes)
# This is a fallback if CoinGecko API is unavailable
SOLANA_PRICE_USD=150.0

# Price per check in USD
PRICE_PER_CHECK_USD=0.10

# ============ Admin Configuration ============
# Admin API key for protected endpoints (POST /api/admin/wallets)
# Generate a secure key: openssl rand -hex 32
ADMIN_API_KEY=
