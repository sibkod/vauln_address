# ================= LOCAL — разработка на этой машине =================
# Фронт и API на одном хосте: API берём с того же origin (/api),
# поэтому VITE_API_URL пустой.
VITE_API_URL=""
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC=""

# Backend
APP_NAME=vauln-local
DB_TYPE=sqlite
SQLITE_PATH=./data/vauln_address.db
SERVER_PORT=9111
FREE_CHECK_LIMIT=100
SOLANA_USE_DEVNET=true
SOLANA_PAYMENT_ADDR=

# Secrets — заполнить перед сборкой
ADMIN_API_KEY=
JWT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Target platform for the Go binary
GOOS=linux
GOARCH=amd64
CGO_ENABLED=1
